@echo off
rem ===========================================================================
rem  workbuddy2api 开机自启开关
rem  双击运行 = 菜单；也支持命令行：
rem      autostart.bat install     开启开机自启
rem      autostart.bat uninstall   关闭开机自启
rem      autostart.bat status      查看状态
rem
rem  实现方式：在当前用户的「启动」文件夹里放一个 .vbs，登录时用它隐藏窗口
rem  调起 serve.bat（服务进程与窗口无关，不会因为误关窗口而停服）。
rem  选用户级而非计划任务：不需要管理员权限，写入失败的概率最低，
rem  卸载就是删一个文件，没有残留。
rem ===========================================================================
setlocal
cd /d "%~dp0"

set "APPDIR=%~dp0"
if "%APPDIR:~-1%"=="\" set "APPDIR=%APPDIR:~0,-1%"
set "STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "VBSFILE=%STARTUP%\workbuddy2api-autostart.vbs"
set "PORT=7863"
set "LOGFILE=%APPDIR%\logs\server.log"

if /i "%~1"=="install"   goto install
if /i "%~1"=="uninstall" goto uninstall
if /i "%~1"=="status"    goto status
if /i "%~1"=="run"       goto runnow
goto menu

rem ---------------------------------------------------------------- 菜单
:menu
cls
echo ============================================
echo   workbuddy2api 开机自启
echo ============================================
echo.
call :is_on
if defined ON (echo   当前状态：已开启) else (echo   当前状态：未开启)
call :port_busy
if defined BUSY (echo   服务进程：运行中 ^(PID %BUSY%^)) else (echo   服务进程：未运行)
echo.
echo   1. 开启开机自启
echo   2. 关闭开机自启
echo   3. 查看详细状态
echo   4. 立即启动一次服务 ^(会开一个日志窗口^)
echo   0. 退出
echo.
set "CH="
set /p "CH=请输入序号: "
if "%CH%"=="1" goto install
if "%CH%"=="2" goto uninstall
if "%CH%"=="3" goto status
if "%CH%"=="4" goto runnow
if "%CH%"=="0" goto :eof
echo.
echo 无效输入，请重新选择。
timeout /t 2 >nul
goto menu

rem ---------------------------------------------------------------- 开启
:install
if not exist "%~dp0serve.bat" (
  echo [x] 缺少 serve.bat，无法安装自启。请先确认文件完整。
  goto end
)
if not exist "%~dp0bin\server.exe" (
  echo [x] 缺少 bin\server.exe，自启后也起不来。请先 build.bat 或 redeploy.bat。
  goto end
)
if not exist "%STARTUP%" mkdir "%STARTUP%" >nul 2>&1

call :is_on
if defined ON (echo [*] 自启项已存在，重新写入一份最新的...) else (echo [*] 正在写入自启项...)

rem 内容为 VBScript：登录时隐藏窗口调起 serve.bat（0 = 不显示窗口，False = 不等它退出）
>"%VBSFILE%" echo ' workbuddy2api logon autostart - generated by autostart.bat, do not edit
>>"%VBSFILE%" echo Option Explicit
>>"%VBSFILE%" echo Dim sh
>>"%VBSFILE%" echo Set sh = CreateObject("WScript.Shell")
>>"%VBSFILE%" echo sh.CurrentDirectory = "%APPDIR%"
>>"%VBSFILE%" echo sh.Run """%APPDIR%\serve.bat""", 0, False

if not exist "%VBSFILE%" (
  echo [x] 写入失败，请检查启动文件夹权限：%STARTUP%
  goto end
)
echo [OK] 已开启：下次登录 Windows 会自动启动 workbuddy2api
echo     自启文件：%VBSFILE%
echo     服务日志：%LOGFILE%
echo.
echo     现在就想用，回菜单选 4，或直接双击 start.bat
echo     关闭自启：菜单选 2（也可以删掉上面那个 .vbs，效果一样）
goto end

rem ---------------------------------------------------------------- 关闭
:uninstall
call :is_on
if not defined ON (
  echo [*] 当前本来就没开启开机自启，无需操作。
  goto end
)
del /f /q "%VBSFILE%" >nul 2>&1
if exist "%VBSFILE%" (
  echo [x] 删除失败，请手动删除：%VBSFILE%
  goto end
)
echo [OK] 已关闭开机自启（启动文件夹里的 .vbs 已删除）
echo     注意：正在运行的服务不受影响，需要停服请双击 stop.bat
goto end

rem ---------------------------------------------------------------- 状态
:status
echo.
echo === 开机自启状态 ===
call :is_on
if defined ON goto st_on
echo   自启项：未开启
goto st_svc
:st_on
echo   自启项：已开启
echo   文件：  %VBSFILE%
:st_svc
call :port_busy
if defined BUSY goto st_up
echo   服务：  未运行
goto st_tail
:st_up
echo   服务：  运行中，PID %BUSY%
curl.exe -s --noproxy 127.0.0.1 -o nul -w "  healthz -> HTTP %%{http_code}\n" --max-time 3 http://127.0.0.1:%PORT%/healthz
:st_tail
echo   日志：  %LOGFILE%
echo   面板：  http://127.0.0.1:%PORT%/panel/
if defined ON echo   提示：  任务管理器 -「启动应用」里也能临时停用这一项
goto end

rem ---------------------------------------------------------------- 立即启动
:runnow
call :port_busy
if defined BUSY (
  echo [*] 服务已在运行 ^(PID %BUSY%^)，无需启动。
  goto end
)
echo [*] 启动服务（日志窗口，关闭窗口即停服）...
call "%~dp0wb2api.bat" start
goto end

rem ---------------------------------------------------------------- 公共
:is_on
set ON=
if exist "%VBSFILE%" set ON=1
goto :eof

:port_busy
set BUSY=
for /f "tokens=5" %%a in ('netstat -ano 2^>nul ^| findstr /c:":%PORT% " ^| findstr /i "LISTEN"') do set BUSY=%%a
goto :eof

:end
echo.
if "%~1"=="" pause
endlocal
